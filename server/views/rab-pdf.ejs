                        %>
                                <table class="center">
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < qrCode.approval3.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><img src="<%=qrCode.qrPath%><%=qrCode.approval3[i]%>" width="80"></td>
                                        <% }%>
                                    </tr>
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < approver3.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><%=approver3[i].user.name%></td>
                                        <% }%>
                                    </tr>
                                </table>
                                
                        <%
