                                <tr style="padding:0; margin:0">
                                    <% for(var i = 0; i < qrCode.approval1.length; i++ ) { %>
                                        <td style="padding:0; margin:0"><img src="<%=qrCode.qrPath%><%=qrCode.approval1[i]%>" width="80"></td>
                                    <% }%>
                                </tr>
                                <tr style="padding:0; margin:0">
                                    <% for(var i = 0; i < approver1.length; i++ ) { %>
                                        <td style="padding:0; margin:0"><%=approver1[i].user.name%></td>
                                    <% }%>
                                </tr>
                            </table>
                            
                    <%
                        }
                    %>
                    </td>
                    <td style="text-align: center;vertical-align: middle;">
                        
                        <%
                            if( qrCode.approval2.length > 0 ){

                        %>
