                                        <% }%>
                                    </tr>
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < approver2.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><%=approver2[i].user.name%></td>
                                        <% }%>
                                    </tr>
                                </table>
                                
                        <%
                            }
                        %>
                    </td>
                    <td style="text-align: center;vertical-align: middle;">
                        
