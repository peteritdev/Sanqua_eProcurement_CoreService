<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <style>
      @page {
        size: A4 landscape;
        margin: 15mm;
      }

      body {
        font-family: Arial, sans-serif;
        font-size: 9px;
      }
      /* tr, td, th {
        border: 1px solid black;
      } */

      .title {
        text-align: center;
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 15px;
      }

      .info-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9px;
        margin-bottom: 10px;
      }

      .info-table td {
        padding: 2px 2px;
        vertical-align: top;
      }

      .info-label {
        width: 5%;
        white-space: nowrap;
      }

      .info-value {
        width: 45%;
      }

      .main-table {
        width: 100%;
        border: 1px solid black;
        border-collapse: collapse;
        margin-top: 5px;
      }

      .main-table th,
      .main-table td {
        border: 1px solid #000 !important;
        padding: 4px;
        /* text-align: center; */
      }

      .main-table th {
        background-color: #f0f0f0;
        font-size: 9px;
      }

      .section-header td {
        background-color: #d9d9d9;
        font-weight: bold;
        text-align: left;
      }

      .note-table {
        width: 100%;
        font-size: 8.5px;
        margin-top: 12px;
      }

      .signature-section {
        width: 100%;
        margin-top: 20px;
        text-align: center;
        font-size: 9px;
      }

      .signature-section td {
        padding: 5px;
      }

      .right-align {
        text-align: right;
      }

      .total-info {
        font-weight: bold;
        font-size: 10px;
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 0;
        margin-bottom: 0;
        width:99%;
        /* border-collapse:collapse; */
        text-align:center;
        font-size: 8px;
        font-family: 'Arial';
        /* border-style: solid;
        border-color: #000000; */
      }
      </style>
  </head>
  <body>
    <div class="title">RAB <%=data.data.name%></div>

    <table class="info-table">
      <tr>
        <td class="info-label">Nomor RAB</td>
        <td class="info-value">: <%=data.data.budget_no%></td>
      </tr>
      <!-- <tr>
      <td class="info-label">Unit</td>
      <td class="info-value">: <%=data.data.name%></td>
    </tr> -->
      <tr>
        <td class="info-label">Penanggung Jawab</td>
        <td class="info-value">
          : <%=data.data.pic_employee != null ? data.data.pic_employee.name :
          '-'%>
        </td>
      </tr>
      <tr>
        <td class="info-label">PIC</td>
        <td class="info-value">
          : <%=data.data.employee != null ? data.data.employee.name : '-'%>
        </td>
      </tr>
      <tr>
        <td class="info-label">Unit</td>
        <td class="info-value">
          : <%=data.data.company != null ? data.data.company.name : '-'%>
        </td>
      </tr>
      <tr>
        <td class="info-label">Department</td>
        <td class="info-value">
          : <%=data.data.department != null ? data.data.department.name : '-'%>
        </td>
      </tr>
    </table>

    <table class="main-table">
      <thead>
        <tr>
          <th rowspan="2">No.</th>
          <!-- <th rowspan="2">Plant</th>
        <th rowspan="2">PIC</th> -->
          <th rowspan="2">Nama Barang</th>
          <th rowspan="2">Spesifikasi</th>
          <th rowspan="2">Merek & Tipe</th>
          <th rowspan="2">Kepentingan/Kegunaan</th>
          <th rowspan="2">Qty</th>
          <th rowspan="2">Satuan</th>
          <th colspan="2">Budget</th>
        </tr>
        <tr>
          <th>Harga Satuan</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% var index = 1; data.data.budget_plan_detail.forEach( item => { %> <%
        if (item.section_title && index == 1) { %>
        <tr class="section-header">
          <td colspan="11"><%=item.section_title%></td>
        </tr>
        <% } else { %> <%
          if (index > 1 && item.section_title && item.section_title != data.data.budget_plan_detail[index - 2].section_title ) { %>
          <tr class="section-header">
            <td colspan="11"><%=item.section_title%></td>
          </tr>
          <% } %>
        <% } %>
        <tr>
          <td><%=index%></td>
          <!-- <td><%=data.data.company != null ? data.data.company.alias : '-'%></td>
        <td><%=data.data.department != null ? data.data.department.name : '-'%></td> -->
          <td><%=item.product != null ? item.product.name : '-'%></td>
          <td>
            <%=item.merk + ' ' + ' ' + item.material + ' ' + item.dimension%>
          </td>
          <td><%=item.merk + ' ' + item.type%></td>
          <td><%=item.description%></td>
          <td class="right-align"><%=item.qty%></td>
          <td><%=item.uom != null ? item.uom.name : '-'%></td>
          <td class="right-align">
            <%=item.budget_price_per_unit.toLocaleString('id-ID')%>
          </td>
          <td class="right-align">
            <%=item.budget_price_total.toLocaleString('id-ID')%>
          </td>
        </tr>
        <% index++; } ) %>
      </tbody>
    </table>

    <table class="info-table" style="margin-top: 10px">
      <tr class="total-info">
        <td class="right-align" style="width: 85%">TOTAL PENGAJUAN :</td>
        <td class="right-align">
          <%=data.data.total_budget_plan.toLocaleString('id-ID')%>
        </td>
      </tr>
      <tr class="total-info">
        <td class="right-align">REALISASI :</td>
        <td class="right-align">-</td>
      </tr>
      <tr class="total-info">
        <td class="right-align">Selisih :</td>
        <td class="right-align">-</td>
      </tr>
    </table>

    <table class="note-table">
      <tr>
        <td>
          <strong>Note :</strong><br />
          <%=data.data.note%>
        </td>
      </tr>
    </table>

    <table class="signature-section">
      <tr>
        <td colspan="4" style="text-align: left">
          Jakarta, <%=data.data.created_at%>
        </td>
      </tr>
      <tr>
        <td colspan="4" style="padding:0px;margin:0px;">
            <table class="center" cellspacing="0" cellpadding="0"  border="1" style="width:100%; border-width: 0.1px; font-size: 10px;">
                <tr style="padding:0; margin:0">
                    <td rowspan="2" style="padding:0; margin:0">
                        Dibuat Oleh
                    </td>
                    <td colspan="2" style="padding:0; margin:0">
                        Mengetahui
                    </td>
                    <td colspan="2" style="padding:0; margin:0">
                        Disetujui
                    </td>
                </tr>
                <tr style="padding:0; margin:0">
                    <td style="padding:0; margin:0">Head Department</td>
                    <td style="padding:0; margin:0">Dept. Pembelian Plant</strong></td>
                    <td style="padding:0; margin:0">PM / Head HCGS</td>
                    <!-- <td>Head F&A</td> -->
                    <!-- <td>Head Procurement</td> -->
                    <td style="padding:0; margin:0">Direktur</td>
                </tr>
                <tr>
                    <td style="text-align: center; vertical-align: middle;" width="10">
                        <table class="center">
                          <tr>
                            <%=data.data.employee.name%>
                          </tr>
                        </table>
                    </td>
                    <td style="text-align: center;vertical-align: middle;">
                        
