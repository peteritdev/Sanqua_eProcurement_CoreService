                        %>
                    </td>
                    <!-- <td style="text-align: center;vertical-align: middle;">
                        
                        <%
                            if( qrCode.approval4.length > 0 ){

                        %>
                                <table class="center">
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < qrCode.approval4.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><img src="<%=qrCode.qrPath%><%=qrCode.approval4[i]%>" width="80"></td>
                                        <% }%>
                                    </tr>
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < approver4.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><%=approver4[i].user.name%></td>
                                        <% }%>
                                    </tr>
                                </table>
                                
                        <%
                            }
                        %>
                    </td> -->
                    <td style="text-align: center;vertical-align: middle;">
                        
                        <%
                            if( qrCode.approval5.length > 0 ){

                        %>
                                <table class="center">
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < qrCode.approval5.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><img src="<%=qrCode.qrPath%><%=qrCode.approval5[i]%>" width="80"></td>
                                        <% }%>
                                    </tr>
                                    <tr style="padding:0; margin:0">
                                        <% for(var i = 0; i < approver5.length; i++ ) { %>
                                            <td style="padding:0; margin:0"><%=approver5[i].user.name%></td>
                                        <% }%>
                                    </tr>
                                </table>
                                
                        <%
                            }
                        %>
                    </td>
                    <!-- <td style="text-align: center;vertical-align: middle;">
                        <%
                            if( qrCode.approval2 != '' ){
                        %>
                            <img src="<%=qrCode.approval2%>" width="80">
                        <%
                            }
                        %>                                
                    </td> -->
                    
                </tr>
                <!-- <tr style="height: 20px;">
                    <td><%=data.data.employee.name%></td>
                    <td><%=approver1%></td>
                    <td><%=approver2%></td>                            
                    <td><%=approver3%></td>
                    <td><%=approver4%></td>
                    <td  style="border-right: none !important;"><%=approver5%></td>
                </tr> -->
            </table>
        </td>
      </tr>
      <!-- <tr>
      <td>Dibuat Oleh,<br><br><br><br><%=data.data.created_by_name%><br>............................</td>
      <td>Mengetahui,<br><br><br><br>............................</td>
      <td>Diperiksa Oleh,<br><br><br><br>............................</td>
      <td>Disetujui Oleh,<br><br><br><br>............................</td>
    </tr> -->
    </table>
  </body>
</html>
