<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style>
      /*html {
                  zoom: 0.75; style="width: 95%; border-width: thin; border-spacing: 0px;font-size: 9px;border-color: grey;" border="1" 
                }*/
      html {
        zoom: 0.70;
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 15px;
        width: 99%;
        /* border-collapse:collapse; */
        text-align: center;
        font-size: 12px;
        font-family: "Arial";
        border-style: solid;
        border-color: #696969;
      }

      .center th,
      .center td {
        border-left: none;
        border-bottom: none;
      }

      .col-item {
        border-bottom: none;
        border-top: none;
      }

      .border-b {
        border-bottom: 1px solid #696969 !important;
      }
      .border-t {
        border-top: 1px solid #696969;
      }

      .border-tr {
        border-top: 1px solid #696969;
        border-right: 1px solid #696969;
      }
      .border-r {
        border-right: 1px solid #696969;
      }

      .border-rb {
        border-right: 1px solid #696969;
        border-bottom: 1px solid #696969 !important;
      }

      th.col-header-item {
        border-bottom: 1px solid #696969;
        border-right: 1px solid #696969;
      }
    </style>
  </head>
  <body>
    <table
      class="center"
      cellspacing="0"
      cellpadding="5"
      style="border: 1px solid #696969;"
    >
      <tr>
        <td style="width: 20%; text-align: left; padding-left: 10px">
          <img src="<%=companyData.logo%>" height="45" />
        </td>
        <td style="text-align: center; width: 60%">
          <span
            style="
              font-size: 18px;
              text-align: center;
              padding: 7px 25px 7px 25px;
              border-radius: 5px;
              border:1px solid black;
            "
            ><strong>PENERIMAAN BARANG</strong></span
          >
        </td>
        <th
          style="
            width: 20%;
            padding: 3px;
            text-align: right;
            vertical-align: bottom;
          "
        >
          <span style="width: 240px; margin-left: -20px; font-size: 10px;">Doc No: FRM.WHM.01.01</span>
        </th>
      </tr>
      <tr>
        <td colspan="3" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: left"
          >
            <tr>
              <td colspan="2" style="width: 66.65%">
                <span style="display: flex; justify-content: space-between"
                  >Diterima Dari </span
                ><span style="margin-right: 2px;">:</span>
              </td>
              <td style="width: 33.35%">
                <table style="width: 100%;">
                  <tr>
                    <td style="width: 70px;">No PO</td>
                    <td > <span style="margin-right: 2px;">:</span> <%=data.data.po_no%></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td colspan="2" style="width: 66.65%">
                <span style="position: relative; top: -10px;"><%=data.data.received_from_vendor_name%></span>
              </td>
              <td style="width: 33.35%">
                <table style="width: 100%;">
                  <tr>
                    <td style="width: 70px;">No Form</td>
                    <td > <span style="margin-right: 2px;">:</span> <%=data.data.purchase_request.request_no%></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td colspan="2" style="width: 66.65%;">
                <span style="display: flex; justify-content: space-between"
                >No. Terima</span
              ><span style="margin-right: 2px;">:</span>  <%=data.data.document_no%>
              </td>
              <td style="width: 33.35%">
                
                <table style="width: 100%;">
                  <tr>
                    <td style="width: 70px;">Tgl. Terima</td>
                    <td > <span style="margin-right: 2px;">:</span><%=new Date(data.data.createdAt).toLocaleDateString('id')%></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="3" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: center"
          >
            <thead>
              <tr>
                <th style="width: 3%" class="col-header-item">No</th>
                <th style="width: 62%" class="col-header-item">Uraian</th>
                <th class="col-header-item">Qty</th>
                <th class="col-header-item">Uom</th>
                <th colspan="2" style="width: 23.35%; border-right:none;" class="col-header-item">Keterangan</th>
              </tr>
            </thead>
            <tbody>
              <% var index = 1; data.data.goods_receipt_detail.forEach( item => { %>
                <tr>
                  <td style="text-align: center" class="border-rb"><%=index%>.</td>
                  <td style="text-align: left" class="border-rb">
                    <%=item.product.name%>
                  </td>
                  <td style="text-align: center" class="border-rb"><%=item.qty_done%></td>
                  <td style="text-align: center" class="border-rb"><%=item.uom_name%></td>
                  <td colspan="2"
                    style="text-align: center; border-right: none"
                    class="border-rb"
                  >
                    <%=item.description%>
                  </td>
                </tr>
              <% index++; } ) %>
              
              <%
                if(data.data.goods_receipt_detail.length < 10 ){
              %>
                <% for (let i = 0; i < 10 - data.data.goods_receipt_detail.length; i++) { %>
                  <tr style="height: 25px;">
                    <td style="text-align: center" class="border-rb"></td>
                    <td style="text-align: left" class="border-rb">
                    </td>
                    <td style="text-align: center" class="border-rb"></td>
                    <td style="text-align: center" class="border-rb"></td>
                    <td colspan="2"
                      style="text-align: center; border-right: none"
                      class="border-rb"
                    >
                    </td>
                  </tr>
                <% } %>
              <% } %>
              
            </tbody>
          </table>
        </td>
      </tr>
      
      <tr>
        <td colspan="5" style="padding: 0px; margin: 0px">
          <table
            cellspacing="0"
            cellpadding="2"
            style="width: 100%; border-width: 0.2px"
          >
            <tr>
              <th rowspan="4" style="width: 40%; font-weight: 400; vertical-align: top; text-align: left;" class="border-r">Notes:</td>
              <th
                style="width: 60%"
                colspan="4"
                style="font-size: 14px;"
                class="border-b"
              >
                <span style="font-weight: 400; text-align: left; margin-right: auto;">*Validasi disertai ttd & nama jelas</span>
              </th>
            </tr>
            <tr>
              <th class="border-rb" style="font-weight: 400; width: 20%;">Diserahkan oleh,</th>
              <th class="border-rb" style="font-weight: 400; width: 20%;">Diterima oleh,</th>
              <th class="border-b" style="font-weight: 400; width: 20%;">Mengetahui,</th>
            </tr>
            <tr>
              <td class="border-rb">
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <%
                    if(data.data.submitted_by_name != null && data.data.submitted_by_name != '' ){
                    %>
                      <td style="vertical-align: bottom;"><%=data.data.submitted_by_name%></td>
                    <%
                        }
                    %>
                  </tr>
                </table>
              </td>
              <td class="border-rb">
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <%
                    if(data.data.received_by_name != null && data.data.received_by_name != '' ){
                    %>
                      <td style="vertical-align: bottom;"><%=data.data.received_by_name%></td>
                    <%
                        }
                    %>
                  </tr>
                </table>
              </td>
              <td class="border-b">
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <td style="vertical-align: bottom;"></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <th class="border-r" style="font-weight: 400;">Vendor</th>
              <th class="border-r" style="font-weight: 400;">Gudang</th>
              <th style="font-weight: 400;">QC</th>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
