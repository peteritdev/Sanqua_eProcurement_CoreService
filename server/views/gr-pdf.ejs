<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style>
      /*html {
                  zoom: 0.75; style="width: 95%; border-width: thin; border-spacing: 0px;font-size: 9px;border-color: grey;" border="1" 
                }*/
      html {
        zoom: 0.70;
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 15px;
        width: 99%;
        /* border-collapse:collapse; */
        text-align: center;
        font-size: 12px;
        font-family: "Arial";
        border-style: solid;
        border-color: #696969;
      }

      .center th,
      .center td {
        border-left: none;
        border-bottom: none;
      }

      .col-item {
        border-bottom: none;
        border-top: none;
      }

      .border-b {
        border-bottom: 1px solid #696969 !important;
      }
      .border-t {
        border-top: 1px solid #696969;
      }

      .border-tr {
        border-top: 1px solid #696969;
        border-right: 1px solid #696969;
      }
      .border-r {
        border-right: 1px solid #696969;
      }

      .border-rb {
        border-right: 1px solid #696969;
        border-bottom: 1px solid #696969 !important;
      }

      th.col-header-item {
        border-bottom: 1px solid #696969;
        border-right: 1px solid #696969;
      }
    </style>
  </head>
  <body>
    <table
      class="center"
      cellspacing="0"
      cellpadding="5"
      style="border: 1px solid #696969;"
    >
      <tr>
        <td style="width: 20%; text-align: left; padding-left: 10px">
          <img src="<%=companyData.logo%>" height="45" />
        </td>
        <td style="text-align: center; width: 60%">
          <span
            style="
              font-size: 18px;
              text-align: center;
              padding: 7px 25px 7px 25px;
              border-radius: 5px;
              border:1px solid black;
            "
            ><strong>PENERIMAAN BARANG</strong></span
          >
        </td>
        <th
          style="
            width: 20%;
            padding: 3px;
            text-align: right;
            vertical-align: bottom;
          "
        >
          <span>Doc No: FRM.WHM.01.01</span>
        </th>
      </tr>
      <tr>
        <td colspan="3" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: left"
          >
            <tr>
              <td style="width: 10%">
                <span style="display: flex; justify-content: space-between"
                  >Diterima Dari </span
                >
              </td>
              <td style="width: 56.65%" class="border-r">
                <span style="margin-right: 2px;">:</span> <%=data.data.received_from_vendor_name%>
              </td>
              <td style="width: 33.35%">
                <table style="width: 100%;">
                  <tr>
                    <td style="width: 80px;">No PO</td>
                    <td > <span style="margin-right: 2px;">:</span> <%=data.data.po_no%></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="width: 10%">
                <span style="display: flex; justify-content: space-between"
                  >No. SJ</span
                >
              </td>
              <td style="width: 56.65%" class="border-r">
                <span style="margin-right: 2px;">:</span> <%=data.data.sj_no%>
              </td>
              <td style="width: 33.35%">
                <table style="width: 100%;">
                  <tr>
                    <td style="width: 80px;">No FPB</td>
                    <td > <span style="margin-right: 2px;">:</span> <%=data.data.purchase_request.request_no%></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="width: 10%">
                <!-- <span style="display: flex; justify-content: space-between"
                  >Diterima Oleh <span>:</span></span
                > -->
              </td>
              <td style="width: 56.65%" class="border-r">
                <!-- ............................. -->
              </td>
              <td style="width: 33.35%">
                
                <table style="width: 100%;">
                  <tr>
                    <td style="width: 80px;">Tgl. Terima</td>
                    <td > <span style="margin-right: 2px;">:</span><%=new Date(data.data.createdAt).toLocaleDateString('id')%></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="3" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: center"
          >
            <thead>
              <tr>
                <th style="width: 3%" class="col-header-item">No</th>
                <th style="width: 52%" class="col-header-item">Uraian</th>
                <th class="col-header-item">Qty</th>
                <th class="col-header-item">Uom</th>
                <th colspan="2" style="width: 33.35%; border-right:none;" class="col-header-item">Keterangan</th>
              </tr>
            </thead>
            <tbody>
              <% var index = 1; data.data.goods_receipt_detail.forEach( item => { %>
                <tr>
                  <td style="text-align: center" class="border-rb">1</td>
                  <td style="text-align: left" class="border-rb">
                    Lorem ipsum dolor, sit amet consectetur adipisicing elit.
                    Sequi, libero!
                  </td>
                  <td style="text-align: center" class="border-rb">10</td>
                  <td style="text-align: center" class="border-rb">Pcs</td>
                  <td colspan="2"
                    style="text-align: center; border-right: none"
                    class="border-rb"
                  >
                    Lorem ipsum dolor sit amet.
                  </td>
                </tr>
              <% index++; } ) %>
              
              <%
                if(data.data.goods_receipt_detail.length < 10 ){
              %>
                <% for (let i = 0; i < 10 - data.data.goods_receipt_detail.length; i++) { %>
                  <tr style="height: 25px;">
                    <td style="text-align: center" class="border-rb"></td>
                    <td style="text-align: left" class="border-rb">
                    </td>
                    <td style="text-align: center" class="border-rb"></td>
                    <td style="text-align: center" class="border-rb"></td>
                    <td colspan="2"
                      style="text-align: center; border-right: none"
                      class="border-rb"
                    >
                    </td>
                  </tr>
                <% } %>
              <% } %>
              
            </tbody>
          </table>
        </td>
      </tr>
      
      <tr>
        <td colspan="5" style="padding: 0px; margin: 0px">
          <table
            cellspacing="0"
            cellpadding="2"
            style="width: 100%; border-width: 0.2px"
          >
            <tr>
              <th style="width: 25%" rowspan="2">Diserahkan Oleh,</td>
              <th style="width: 25%" class="border-r" rowspan="2">Diterima Oleh,</td>
              <th
                style="width: 50%"
                colspan="3"
                style="font-size: 14px"
                class="border-b"
              >
                Mengetahui
              </th>
            </tr>
            <tr>
              <th style="width: 78%" class="border-r">QC</th>
            </tr>
            <tr>
              <td>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <%
                    if(data.data.submitted_by_name != null && data.data.submitted_by_name != '' ){
                    %>
                      <td><%=data.data.submitted_by_name%></td>
                    <%
                        }
                    %>
                    <%
                    if(data.data.submitted_by_name == null || data.data.submitted_by_name == '' ){
                    %>
                    <td>(.............................)</td>
                    <%
                        }
                    %>
                  </tr>
                </table>
              </td>
              <td class="border-r">
                
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <%
                    if(data.data.received_by_name != null && data.data.received_by_name != '' ){
                    %>
                      <td><%=data.data.received_by_name%></td>
                    <%
                        }
                    %>
                    <%
                    if(data.data.received_by_name == null || data.data.received_by_name == '' ){
                    %>
                    <td>(.............................)</td>
                    <%
                        }
                    %>
                  </tr>
                </table>
              </td>
              <td class="border-r">
                
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <%
                    if(data.data.received_by_name != null && data.data.received_by_name != '' ){
                    %>
                      <td><%=data.data.received_by_name%></td>
                    <%
                        }
                    %>
                    <%
                    if(data.data.received_by_name == null || data.data.received_by_name == '' ){
                    %>
                    <td>(.............................)</td>
                    <%
                        }
                    %>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
