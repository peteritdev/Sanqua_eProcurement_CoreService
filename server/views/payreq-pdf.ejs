                  zoom: 0.75; style="width: 95%; border-width: thin; border-spacing: 0px;font-size: 9px;border-color: grey;" border="1" 
                }*/
      html {
        zoom: 0.8;
      }
      .body {
        font-family: "Arial" !important;
        font-weight: 400;
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 15px;
        width: 99%;
        /* border-collapse:collapse; */
        text-align: center;
        font-size: 8px;
        border-style: solid;
        border-color: #252525;
      }

      .center th,
      .center td {
        border-left: none;
        border-bottom: none;
      }

      .col-item {
        border-bottom: none;
        border-top: none;
      }

      .border-b {
        border-bottom: 1px solid #252525 !important;
      }
      .border-t {
        border-top: 1px solid #252525;
      }

      .border-tr {
        border-top: 1px solid #252525;
        border-right: 1px solid #252525;
      }
      .border-r {
        border-right: 1px solid #252525;
      }

      .border-rb {
        border-right: 1px solid #252525;
        border-bottom: 1px solid #252525 !important;
      }

      th.col-header-item {
        border-bottom: 1px solid #252525;
        border-right: 1px solid #252525;
