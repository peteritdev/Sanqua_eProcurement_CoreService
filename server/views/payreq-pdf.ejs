<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style>
      @media print {
        .page-break {
          page-break-before: always;
        }

        .no-break {
          page-break-inside: avoid;
        }
      }
      html {
        /* zoom: 0.8; */
        zoom: 0.6;
        color: black !important;
      }
      tr, td, th {
        page-break-inside: avoid; /* hindari potongan di tengah baris */
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 15px;
        width: 99%;
        font-family: Arial, Helvetica, sans-serif;
        /* border-collapse:collapse; */
        text-align: center;
        font-size: 10px;
        border-style: solid;
        border-color: #000000;
      }

      .center th,
      .center td {
        border-left: none;
        border-bottom: none;
      }

      .col-item {
        border-bottom: none;
        border-top: none;
      }

      .border-b {
        border-bottom: 1px solid #000000 !important;
      }
      .border-t {
        border-top: 1px solid #000000;
      }

      .border-tr {
        border-top: 1px solid #000000;
        border-right: 1px solid #000000;
      }
      .border-r {
        border-right: 1px solid #000000;
      }

      .border-rb {
        border-right: 1px solid #000000;
        border-bottom: 1px solid #000000 !important;
      }
      .p-relative {
        position: relative;
      }
      .span-strike {
        position:absolute; left:0; right:0; top:50%; border-top:1px solid rgba(255, 0, 0, 0.7); pointer-events:none;
      }

      th.col-header-item {
        border-bottom: 1px solid #000000;
        border-right: 1px solid #000000;
      }
    </style>
  </head>
