<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style>
      /*html {
                  zoom: 0.75; style="width: 95%; border-width: thin; border-spacing: 0px;font-size: 9px;border-color: grey;" border="1" 
                }*/
      html {
        zoom: 1;
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 15px;
        width: 99%;
        /* border-collapse:collapse; */
        text-align: center;
        font-size: 12px;
        font-family: "Arial";
        border-style: solid;
        border-color: #000000;
      }

      .center th,
      .center td {
        border-left: none;
        border-bottom: none;
      }

      .col-item {
        border-bottom: none;
        border-top: none;
      }

      .border-b {
        border-bottom: 1px solid #000000 !important;
      }
      .border-t {
        border-top: 1px solid #000000;
      }

      .border-tr {
        border-top: 1px solid #000000;
        border-right: 1px solid #000000;
      }
      .border-r {
        border-right: 1px solid #000000;
      }

      .border-rb {
        border-right: 1px solid #000000;
        border-bottom: 1px solid black !important;
      }

      th.col-header-item {
        border-bottom: 1px solid #000000;
        border-right: 1px solid #000000;
      }
    </style>
  </head>
  <body style="padding: 10px">
    <table
      class="center"
      cellspacing="0"
      cellpadding="5"
      style="border: 1px solid #000000;"
    >
      <tr>
        <td style="width: 10%; text-align: left; padding-left: 10px">
          <img src="<%=companyData.logo%>" height="45" />
        </td>
        <!-- <td style="text-align: center; width: 5%"></td> -->
        <td style="text-align: right; width: 65%;">
          <span
            style="
              font-size: 18px;
              text-align: center;
              padding: 7px 25px 7px 25px;
              border-radius: 5px;
              border:1px solid black;
            "
            ><strong>PERTANGGUNGJAWABAN CASH ADVANCE</strong></span
          >
        </td>
        <!-- <td style="text-align: center; width: 5%"></td> -->
        <th
          style="
            width: 25%;
            padding: 3px;
            text-align: right;
            vertical-align: bottom;
          "
        >
          <span>Doc No. FRM ACC.03.02 rev.01</span>
        </th>
      </tr>
      <tr>
        <td colspan="5" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: left"
          >
            <tr>
              <td style="width: 10%">
                <span style="display: flex; justify-content: space-between"
                  >Kepada <span>:</span></span
                >
              </td>
              <td style="width: 60%" class="border-r">DEPARTMENT FINANCE</td>
              <td style="width: 30%">Untuk Payment Request</td>
            </tr>
            <tr>
              <td style="width: 15%">
                <span style="display: flex; justify-content: space-between"
                  >Dari <span>:</span></span
                >
              </td>
              <td style="width: 46.65%" class="border-r">
                DEPARTMENT <%=data.data.department_name%>
              </td>
              <td style="width: 38.35%">
                <span
                  style="
                    display: flex;
                    justify-content: space-between;
                    width: 60px;
                  "
                  >Nomor <span>:</span> <%=data.data.document_no%></span
                >
              </td>
            </tr>
            <tr>
              <td style="width: 15%">
                <span style="display: flex; justify-content: space-between"
                  >Tanggal PJCA <span>:</span></span
                >
              </td>
              <td style="width: 46.65%" class="border-r">
                <%=new Date(data.data.createdAt).toLocaleDateString('id')%>
              </td>
              <td style="width: 38.35%">
                <span
                  style="
                    display: flex;
                    justify-content: space-between;
                    width: 60px;
                  "
                  >Tanggal CA
                  <span>:</span> <%=new Date(data.data.payment_request.created_at).toLocaleDateString('id')%></span
                >
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="5" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: center"
          >
            <thead>
              <tr>
                <th style="width: 3%" class="col-header-item">No</th>
                <th style="width: 60%" class="col-header-item">Uraian</th>
                <th class="col-header-item">Qty</th>
                <th class="col-header-item">Uom</th>
                <th style="width: 12.5%" class="col-header-item">Jumlah</th>
                <th
                  style="width: 12.6%; border-right: none !important"
                  class="col-header-item"
                >
                  Keterangan
                </th>
              </tr>
            </thead>
            <tbody>
              <% var index = 1; data.data.pjca_detail.forEach( item => { %>
              <tr>
                <td style="text-align: center" class="border-rb">
                  <%=index%>.
                </td>
                <td style="text-align: left" class="border-rb">
                  <%=item.product_name%>
                </td>
                <td style="text-align: center" class="border-rb">
                  <%=item.qty_request%>
                </td>
                <td style="text-align: center" class="border-rb">
                  <%=item.uom_name%>
                </td>
                <td style="text-align: right" class="border-rb">
                  <%=item.subtotal%>
                </td>
                <td
                  style="text-align: center; border-right: none; font-size: 10px;"
                  class="border-rb"
                >
                  <%
                  if(item.tax != null){
                  %>
                    <%=item.tax.name%>
                  <%
                      }
                  %>

                  <%
                  if(item.tax == null){
                  %>
                    <%=item.description%>
                  <%
                      }
                  %>
                </td>
              </tr>
              <% index++; } ) %>
              
              <!-- Biaya Pengiriman -->
              <%
              if(data.data.delivery_costs != null && data.data.delivery_costs > 0){
              %>
                <tr>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: left" class="border-rb">
                    Biaya Pengiriman
                  </td>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: right" class="border-rb">
                    <%=data.data.delivery_costs%>
                  </td>
                  <td
                    style="text-align: center; border-right: none"
                    class="border-rb"
                  >
                  </td>
                </tr>
              <%
                  }
              %>

              <!-- Biaya admin / aplikasi -->
              <%
              if(data.data.service_costs != null && data.data.service_costs > 0){
              %>
                <tr>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: left" class="border-rb">
                    Biaya Layanan
                  </td>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: right" class="border-rb">
                    <%=data.data.service_costs%>
                  </td>
                  <td
                    style="text-align: center; border-right: none"
                    class="border-rb"
                  >
                  </td>
                </tr>
              <%
                  }
              %>

              <!-- Biaya Lain-lain -->
              <%
              if(data.data.other_costs != null && data.data.other_costs > 0){
              %>
                <tr>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: left" class="border-rb">
                    Biaya lain-lain
                  </td>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: center" class="border-rb">
                  </td>
                  <td style="text-align: right" class="border-rb">
                    <%=data.data.other_costs%>
                  </td>
                  <td
                    style="text-align: center; border-right: none"
                    class="border-rb"
                  >
                  </td>
                </tr>
              <%
                  }
              %>
              
              <%
              if(data.data.pjca_detail.length < 7 ){
              %>
                <% for (let i = 0; i < 7 - data.data.pjca_detail.length; i++) { %>
                  <tr style="height: 20px;">
                    <td style="text-align: center" class="border-rb">
                      <!-- <%=i%>. -->
                    </td>
                    <td style="text-align: left" class="border-rb">
                      <!-- <%=i%> -->
                    </td>
                    <td style="text-align: center" class="border-rb">
                      <!-- <%=i%> -->
                    </td>
                    <td style="text-align: center" class="border-rb">
                      <!-- <%=i%> -->
                    </td>
                    <td style="text-align: center" class="border-rb">
                      <!-- <%=i%> -->
                    </td>
                    <td
                      style="text-align: center; border-right: none"
                      class="border-rb"
                    >
                      <!-- <%=i%> -->
                    </td>
                  </tr>
                <% } %>
              <%
                  }
              %>
              <tr>
                <th colspan="4" style="text-align: left" class="border-rb">
                  TOTAL
                </th>
                <td style="text-align: right" class="border-rb">
                  <%=data.data.total_price%>
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                  <!-- Lorem ipsum dolor sit amet. -->
                </td>
              </tr>
              <tr>
                <td colspan="6" style="text-align: left" class="border-b">
                  <span style="font-weight: bold"> Terbilang </span>
                  <span style="font-weight: bold; margin: 0 5px">: </span>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="5" style="padding: 0px; margin: 0px">
          <table
            cellspacing="0"
            cellpadding="2"
            style="width: 100%; border-width: 0.2px"
          >
            <tr>
              <th style="width: 25%" rowspan="2">Penanggung Jawab</td>
              <th style="width: 25%" class="border-r" rowspan="2">Ka. Department</td>
              <th
                style="width: 50%"
                colspan="3"
                style="font-size: 14px"
                class="border-b"
              >
                Kolom Persetujuan
              </th>
            </tr>
            <tr>
              <th style="width: 28%" class="border-r">Finance</th>
              <th style="width: 50%">Plant Manager / Direktur</th>
            </tr>
            <tr>
              <td>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <!-- <tr>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval1[i]%>"
                        width="80"
                      />
                    </td>
                  </tr> -->
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <%
                    if(data.data.employee_name != null && data.data.employee_name != '' ){
                    %>
                      <td><%=data.data.employee_name%></td>
                    <%
                        }
                    %>
                    <%
                    if(data.data.employee_name == null || data.data.employee_name == '' ){
                    %>
                    <td>(.............................)</td>
                    <%
                        }
                    %>
                  </tr>
                </table>
              </td>
              <td class="border-r">
                
                <%
                        if( qrCode.approval1.length > 0 ){

                    %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <% for(var i = 0; i < qrCode.approval1.length; i++ ) { %>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval1[i]%>"
                        width="80"
                      />
                    </td>
                    <% }%>
                  </tr>
                  <tr>
                    <% for(var i = 0; i < approver1.length; i++ ) { %>
                    <td><%=approver1[i].user.name%></td>
                    <% }%>
                  </tr>
                </table>
                <%
                        }
                    %>
                    
                <%

                if( qrCode.approval1.length == 0 ){
                %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <td></td>
                  </tr>
                  <tr>
                    <td>(.............................)</td>
                  </tr>
                </table>
                <%
                    }
                %>
              </td>
              <td class="border-r">
                
                <%
                        if( qrCode.approval2.length > 0 ){

                    %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <% for(var i = 0; i < qrCode.approval2.length; i++ ) { %>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval2[i]%>"
                        width="80"
                      />
                    </td>
                    <% }%>
                  </tr>
                  <tr>
                    <% for(var i = 0; i < approver2.length; i++ ) { %>
                    <td><%=approver2[i].user.name%></td>
                    <% }%>
                  </tr>
                </table>
                <%
                        }
                    %>
              </td>
              <td>
                <%
                        if( qrCode.approval3.length > 0 ){
                    %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 80px;">
                  <tr>
                    <% for(var i = 0; i < qrCode.approval3.length; i++ ) { %>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval3[i]%>"
                        width="80"
                      />
                    </td>
                    <% }%>
                  </tr>
                  <tr>
                    <% for(var i = 0; i < approver3.length; i++ ) { %>
                    <td><%=approver3[i].user.name%></td>
                    <% }%>
                  </tr>
                </table>
                <%
                        }
                    %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
