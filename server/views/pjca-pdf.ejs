<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <style>
      /*html {
                  zoom: 0.75; style="width: 95%; border-width: thin; border-spacing: 0px;font-size: 9px;border-color: grey;" border="1" 
                }*/
      html {
        zoom: 0.70;
      }
      .center {
        margin-left: auto;
        margin-right: auto;
        margin-top: 15px;
        width: 99%;
        /* border-collapse:collapse; */
        text-align: center;
        font-size: 12px;
        font-family: "Arial";
        border-style: solid;
        border-color: #696969;
      }

      .center th,
      .center td {
        border-left: none;
        border-bottom: none;
      }

      .col-item {
        border-bottom: none;
        border-top: none;
      }

      .border-b {
        border-bottom: 1px solid #696969 !important;
      }
      .border-t {
        border-top: 1px solid #696969;
      }

      .border-tr {
        border-top: 1px solid #696969;
        border-right: 1px solid #696969;
      }
      .border-r {
        border-right: 1px solid #696969;
      }

      .border-rb {
        border-right: 1px solid #696969;
        border-bottom: 1px solid #696969 !important;
      }

      th.col-header-item {
        border-bottom: 1px solid #696969;
        border-right: 1px solid #696969;
      }
    </style>
  </head>
  <body style="padding: 10px;">
    <table
      class="center"
      cellspacing="0"
      cellpadding="5"
      style="border: 1px solid #696969;"
    >
      <tr>
        <td style="width: 10%; text-align: left; padding-left: 10px">
          <img src="<%=companyData.logo%>" height="45" />
        </td>
        <!-- <td style="text-align: center; width: 5%"></td> -->
        <td style="text-align: right; width: 65%;">
          <span
            style="
              font-size: 18px;
              text-align: center;
              padding: 7px 25px 7px 25px;
              border-radius: 5px;
              border:1px solid black;
            "
            ><strong>PERTANGGUNGJAWABAN CASH ADVANCE</strong></span
          >
        </td>
        <!-- <td style="text-align: center; width: 5%"></td> -->
        <th
          style="
            width: 25%;
            padding: 3px;
            text-align: right;
            vertical-align: bottom;
          "
        >
          <span style="width: 240px; margin-left: -20px; font-size: 10px;">Doc No. FRM ACC.03.02 rev.01</span>
        </th>
      </tr>
      <tr>
        <td colspan="5" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: left"
          >
            <tr>
              <td style="width: 10%">
                <span style="display: flex; justify-content: space-between"
                  >Kepada</span
                >
              </td>
              <td style="width: 60%" class="border-r"> <span style="margin-right: 2px; margin-left: -20px;">:</span>DEPARTMENT FINANCE</td>
              <td style="width: 30%">Untuk Payment Request</td>
            </tr>
            <tr>
              <td>
                <span style="display: flex; justify-content: space-between"
                  >Dari</span
                >
              </td>
              <td style="width: 46.65%" class="border-r">
                <span style="margin-right: 2px; margin-left: -20px;">:</span>DEPARTMENT <%=data.data.department_name%>
              </td>
              <td style="width: 38.35%">
                <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="width: 75px;">Nomor </td>
                    <td>:</td>
                    <td><%=data.data.payment_request.document_no.slice(data.data.payment_request.document_no.lastIndexOf('/'))%></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="width: 15%">
                <span style="display: flex; justify-content: space-between"
                  >Tanggal PJCA</span
                >
              </td>
              <td style="width: 46.65%" class="border-r">
                <span style="margin-right: 2px; margin-left: -20px;">:</span> <%=new Date(data.data.createdAt).toLocaleDateString('id')%>
              </td>
              <td style="width: 38.35%">
                <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="width: 75px">Tanggal CA </td>
                    <td>:</td>
                    <td style="padding-left: 2px;"><%=new Date(data.data.payment_request.created_at).toLocaleDateString('id')%></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="4" style="padding: 2px; margin: 0px" class="border-t">
        </td>
      </tr>
      <tr>
        <td colspan="4" style="padding: 0px; margin: 0px" class="border-t">
          <table
            cellspacing="0"
            cellpadding="5"
            style="width: 100%; text-align: center;"
          >
            <thead>
              <tr>
                <th style="width: 3%; font-weight: 400;" class="col-header-item">No</th>
                <th style="width: 72%; font-weight: 400;" class="col-header-item">Uraian</th>
                <th style="width: 12.5%; font-weight: 400;" class="col-header-item">Jumlah</th>
                <th
                  style="width: 12.6%; border-right: none !important; font-weight: 400;"
                  class="col-header-item"
                >
                  Keterangan
                </th>
              </tr>
            </thead>
            <tbody>
              <% var index = 1; data.data.pjca_detail.forEach( item => { %>
              <tr>
                <td style="text-align: center" class="border-rb">
                  <%=index%>.
                </td>
                <td style="text-align: left" class="border-rb"><%=item.product_name + " (" + item.qty_done + " " + item.uom_name + ") "%> </td>
                <td style="text-align: right" class="border-rb">
                  <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                    <tr>
                      <td>Rp </td>
                      <td style="text-align: right; width: 100%;"><%=item.subtotal != null ? item.subtotal.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                    </tr>
                  </table>
                </td>
                <td
                  style="text-align: center; border-right: none; font-size: 10px;"
                  class="border-rb"
                >
                  <%=item.description%>
                  <%
                  if(item.tax != null){
                  %>
                    <br/>
                    <%=item.tax.name%>
                  <%
                      }
                  %>
                  
                  <%
                  if(item.discount_amount != null && item.discount_amount > 0){
                  %>
                    <br/>
                    <%='Disc: Rp' + item.discount_amount%>
                  <%
                      }
                  %>
                </td>
              </tr>
              <% index++; } ) %>

              <!-- Biaya Pengiriman -->
              <%
              if(data.data.delivery_costs != null && data.data.delivery_costs > 0){
              %>
              <tr>
                <td style="text-align: center" class="border-rb">
                </td>
                <td style="text-align: left" class="border-rb">
                  Biaya Pengiriman
                </td>
                <td style="text-align: right" class="border-rb">
                  <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                    <tr>
                      <td>Rp </td>
                      <td style="text-align: right; width: 100%;"><%=data.data.delivery_costs != null ? data.data.delivery_costs.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                    </tr>
                  </table>
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                </td>
              </tr>
              <%
                  } else {
              %>
              <tr style="height: 25px;">
                <td style="text-align: center" class="border-rb">
                  <!-- <%=i%>. -->
                </td>
                <td style="text-align: left" class="border-rb">
                  <!-- <%=i%> -->
                </td>
                <td style="text-align: center" class="border-rb">
                  <!-- <%=i%> -->
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                  <!-- <%=i%> -->
                </td>
              </tr>
              <%
                  }
              %>

              <!-- Biaya admin / aplikasi -->
              <%
              if(data.data.service_costs != null && data.data.service_costs > 0){
              %>
              <tr>
                <td style="text-align: center" class="border-rb">
                </td>
                <td style="text-align: left" class="border-rb">
                  Biaya Layanan
                </td>
                <td style="text-align: right" class="border-rb">
                  <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                    <tr>
                      <td>Rp </td>
                      <td style="text-align: right; width: 100%;"><%=data.data.service_costs != null ? data.data.service_costs.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                    </tr>
                  </table>
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                </td>
              </tr>
              <%
                  } else {
              %>
              <tr style="height: 25px;">
                <td style="text-align: center" class="border-rb">
                  <!-- <%=i%>. -->
                </td>
                <td style="text-align: left" class="border-rb">
                  <!-- <%=i%> -->
                </td>
                <td style="text-align: center" class="border-rb">
                  <!-- <%=i%> -->
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                  <!-- <%=i%> -->
                </td>
              </tr>
              <%
                  }
              %>

              <!-- Biaya Lain-lain -->
              <%
              if(data.data.other_costs != null && data.data.other_costs > 0){
              %>
              <tr>
                <td style="text-align: center" class="border-rb">
                </td>
                <td style="text-align: left" class="border-rb">
                  Biaya lain-lain
                </td>
                <td style="text-align: right" class="border-rb">
                  <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                    <tr>
                      <td>Rp </td>
                      <td style="text-align: right; width: 100%;"><%=data.data.other_costs != null ? data.data.other_costs.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                    </tr>
                  </table>
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                </td>
              </tr>
              <%
                  }
              %>
              
              <!-- Discount -->
              <%
              if(data.data.global_discount != null && data.data.global_discount > 0){
              %>
              <tr>
                <td style="text-align: center" class="border-rb">
                </td>
                <td style="text-align: left" class="border-rb">
                  Discount Global (<%=data.data.global_discount_percent%>%)
                </td>
                <td style="text-align: right" class="border-rb">
                  <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                    <tr>
                      <td>Rp </td>
                      <td style="text-align: right; width: 100%;"><%=data.data.global_discount != null ? data.data.global_discount.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                    </tr>
                  </table>
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                </td>
              </tr>
              <%
                  }
              %>

              <%
              if(data.data.difference_price != null && data.data.difference_price > 0){
              %>
                <% for (let i = 0; i < 5; i++) { %>
                <tr>
                  <td style="text-align: center; color:white;" class="border-rb">
                    |
                  </td>
                  <%if(i == 0 || i == 4){%>
                    <td style="text-align: left" class="border-rb">
                    </td>
                  <% } %>
                  <%if(i == 1){%>
                    <td class="border-rb">
                      <table style="margin-left: auto;" cellspacing="0" cellpadding="0">
                        <tr>
                          <td style="width: 50px; text-align: right; padding-right: 5px;">CA: </td>
                          <td style="width: 10px; text-align: right;">Rp </td>
                          <td style="width: 120px; text-align: right;"><%=data.data.payment_request.total_price != null ? data.data.payment_request.total_price.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                        </tr>
                      </table>
                    </td>
                  <% } %>
                  <%if(i == 2){%>
                    <td style="text-align: right" class="border-rb">
                      <table style="margin-left: auto;" cellspacing="0" cellpadding="0">
                        <tr>
                          <td style="width: 50px; text-align: right; padding-right: 5px;">Realisasi: </td>
                          <td style="width: 10px; text-align: right;" class="border-b">Rp </td>
                          <td style="width: 120px; text-align: right;" class="border-b"><%=data.data.total_price != null ? data.data.total_price.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                        </tr>
                      </table>
                    </td>
                  <% } %>
                  <%if(i == 3){%>
                    <td class="border-rb">
                      <table style="margin-left: auto;" cellspacing="0" cellpadding="0">
                        <tr>
                          <td style="width: 50px; text-align: right; padding-right: 5px;">Selisih: </td>
                          <td >Rp </td>
                          <td style="width: 120px; text-align: right;"><%=data.data.difference_price != null ? data.data.difference_price.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                        </tr>
                      </table>
                    </td>
                  <% } %>
                  <td style="text-align: right" class="border-rb">
                  </td>
                  <td
                    style="text-align: center; border-right: none"
                    class="border-rb"
                  >
                  </td>
                </tr>
                <% } %>
              <%
                  } else {
              %>
                <%
                  if(data.data.pjca_detail.length < 6 ){
                %>
                    <% for (let i = 0; i < 8 - data.data.pjca_detail.length; i++) { %>
                    <tr style="height: 25px;">
                      <td style="text-align: center" class="border-rb">
                        <!-- <%=i%>. -->
                      </td>
                      <td style="text-align: left" class="border-rb">
                        <!-- <%=i%> -->
                      </td>
                      <td style="text-align: center" class="border-rb">
                        <!-- <%=i%> -->
                      </td>
                      <td
                        style="text-align: center; border-right: none"
                        class="border-rb"
                      >
                        <!-- <%=i%> -->
                      </td>
                    </tr>
                    <% } %>
                <%
                    }
                %>
              <%
                  }
              %>
                
              <tr>
                <th colspan="2" style="text-align: left; font-weight: 400;" class="border-rb">
                  TOTAL
                </th>
                <td style="text-align: right" class="border-rb">
                  <table style="margin-left: auto; width: 100%;" cellspacing="0" cellpadding="0">
                    <tr>
                      <td>Rp </td>
                      <td style="text-align: right; width: 100%;"><%=data.data.total_price != null ? data.data.total_price.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') : 0%></td>
                    </tr>
                  </table>
                </td>
                <td
                  style="text-align: center; border-right: none"
                  class="border-rb"
                >
                  <!-- Lorem ipsum dolor sit amet. -->
                </td>
              </tr>
              <tr>
                <td colspan="4" style="text-align: left" class="border-b">
                  <span> Terbilang </span>
                  <span style="margin: 0 5px">: </span>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
      <tr>
        <td colspan="4" style="padding: 0px; margin: 0px">
          <table
            cellspacing="0"
            cellpadding="2"
            style="width: 100%; border-width: 0.2px"
          >
            <tr>
              <th
                colspan="2"
              >
              </th>
              <th
                colspan="2" class="border-b"
              >
              </th>
            </tr>
            <tr>
              <th style="width: 25%; font-weight: 400;">Penanggung Jawab</th>
              <th class="border-r" style="width: 25%; font-weight: 400;">Ka. Department</th>
              <th
                colspan="2" class="border-b" style="width: 50%; font-weight: 400;"
              >
                Kolom Persetujuan
              </th>
            </tr>
            <tr>
              <th
                colspan="2" class="border-r" style="width: 50%;"
              >
              </th>
              <th class="border-rb" style="width: 25%; font-weight: 400;">Finance</th>
              <th class="border-b" style="width: 25%; font-weight: 400;">Plant Manager / Direktur</th>
            </tr>
            <tr>
              <td>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 45px;">
                  <tr>
                    <td>
                    </td>
                  </tr>
                </table>
              </td>
              <td class="border-r">
                <%
                        if( qrCode.approval1 != null && qrCode.approval1.length > 0 ){

                    %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 45px;">
                  <tr>
                    <% for(var i = 0; i < qrCode.approval1.length; i++ ) { %>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval1[i]%>"
                        width="80"
                      />
                    </td>
                    <% }%>
                  </tr>
                </table>
                <%
                        }
                    %>
              </td>
              <td class="border-rb">
                <%
                        if( qrCode.approval2 != null && qrCode.approval2.length > 0 ){

                    %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 45px;">
                  <tr>
                    <% for(var i = 0; i < qrCode.approval2.length; i++ ) { %>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval2[i]%>"
                        width="80"
                      />
                    </td>
                    <% }%>
                  </tr>
                </table>
                <%
                        }
                    %>
              </td>
              <td class="border-b">
                <%
                        if( qrCode.approval3 != null && qrCode.approval3.length > 0 ){

                    %>
                <table style="margin-left: auto; margin-right: auto; text-align: center; min-height: 45px;">
                  <tr>
                    <% for(var i = 0; i < qrCode.approval3.length; i++ ) { %>
                    <td>
                      <img
                        src="<%=qrCode.qrPath%><%=qrCode.approval3[i]%>"
                        width="80"
                      />
                    </td>
                    <% }%>
                  </tr>
                </table>
                <%
                        }
                    %>
              </td>
            </tr>
            <tr>
              <td style="padding: 3px 0;">
                <table style="margin: auto; text-align: center;">
                  <tr>
                    <td>
                    </td>
                  </tr>
                  <tr>
                    <td><%=data.data.employee_name%></td>
                  </tr>
                </table>
              </td>
              <th style="padding: 3px 0;"
                class="border-r"
              >
              <%
                      if( qrCode.approval1 != null && qrCode.approval1.length > 0 ){

                  %>
              <table style="margin: auto; text-align: center;">
                <tr>
                  <% for(var i = 0; i < approver1.length; i++ ) { %>
                  <td><%=approver1[i].user.name%></td>
                  <% }%>
                </tr>
              </table>
              <%
                      } else {
                  %>
              <table style="margin: auto; text-align: center;">
                <tr>
                  <td></td>
                </tr>
                <tr>
                  <td>(.............................)</td>
                </tr>
              </table>
              <%
                      }
                  %>
              </th>
              <th style="padding: 3px 0;"
                class="border-rb" style="width: 50%;"
              >
              <%
                      if( qrCode.approval2 != null && qrCode.approval2.length > 0 ){

                  %>
              <table style="margin: auto; text-align: center;">
                <tr>
                  <% for(var i = 0; i < approver2.length; i++ ) { %>
                  <td><%=approver2[i].user.name%></td>
                  <% }%>
                </tr>
              </table>
              <%
                      }
                  %>
              </th>
              <th style="padding: 3px 0;"
                class="border-b" style="width: 50%;"
              >
              <%
                      if( qrCode.approval3 != null && qrCode.approval3.length > 0 ){

                  %>
              <table style="margin: auto; text-align: center;">
                <tr>
                  <% for(var i = 0; i < approver3.length; i++ ) { %>
                  <td><%=approver3[i].user.name%></td>
                  <% }%>
                </tr>
              </table>
              <%
                      }
                  %>
              </th>
            </tr>
            <tr>
              <th
                colspan="2"
              >
              </th>
              <th
              >
              </th>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
